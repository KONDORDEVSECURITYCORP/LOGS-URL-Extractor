<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LogsUrlExtractor</AssemblyName>
    <RootNamespace>LogsUrlExtractor</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <Version>2.0.0</Version>
    <Authors>KONDORDEVSECURITY</Authors>
    <Description>LOGS URL Extractor - Modern Edition</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Single-file publish for WPF + WebView2.

      The critical flag here is IncludeAllContentForSelfExtract=true. Without
      it, the default single-file bundler only embeds managed assemblies and
      leaves native DLLs (WebView2Loader.dll, wpfgfx_cor3.dll, PresentationNative_cor3.dll,
      ...) outside the .exe. WPF then fails to resolve compiled XAML (BAML)
      resources referenced via StartupUri="Views/MainWindow.xaml" AND
      WebView2Loader.dll cannot be located, so the process spins up but
      never creates a window.

      With IncludeAllContentForSelfExtract=true the bundler embeds *everything*
      (managed + native + content) inside the .exe. At first launch, .NET
      unpacks the bundle to %TEMP%\.net\<AppName>\<contentHash>\ and loads
      DLLs from there. Startup pays a one-time extraction cost (~1-2s the
      first run, cached afterwards) but the app works reliably.

      PublishReadyToRun=false because R2R images generated by the .NET 10 SDK
      targeting net9.0 can cause load-time issues; the JIT startup delta is
      negligible for a WPF UI app.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\index.html" />
    <EmbeddedResource Include="Assets\index.html" LogicalName="index.html" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude the smoke test helper project from the WPF build. -->
    <Compile Remove="_smoketest\**" />
    <None Remove="_smoketest\**" />
    <EmbeddedResource Remove="_smoketest\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
  </ItemGroup>
</Project>
